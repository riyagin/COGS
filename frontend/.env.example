# Production values live in .env.production. To test real sign-in locally, copy these
# into frontend/.env.development.local; leave unset for local development without sign-in.
# Supabase: Project Settings -> API (Project URL, and the publishable/anon key; never the secret/service_role key).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
