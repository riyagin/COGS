{
  "name": "cogs-desktop",
  "productName": "COGS Desktop",
  "version": "1.0.0",
  "description": "Bulk receipt and stock entry for COGS",
  "author": "riyagin",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.riyagin.cogs.desktop",
    "productName": "COGS Desktop",
    "directories": { "output": "../release/desktop", "buildResources": "build" },
    "files": ["dist/**", "electron/**", "package.json"],
    "asarUnpack": ["node_modules/**"],
    "icon": "../frontend/assets/icon-only.png",
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
