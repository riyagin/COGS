# Copy to backend/.env for local use; on Vercel set these in Project Settings -> Environment Variables.

# Database. Leave unset locally to use the embedded PGlite database.
# Supabase: Connect -> "Transaction pooler" (port 6543).
# DATABASE_URL=postgresql://postgres.gsvbbkszjsbxvekzztiu:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Signs session tokens: a random string of 32+ characters, different per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave unset locally to skip sign-in (deployments refuse to run without it).
# AUTH_SECRET=
