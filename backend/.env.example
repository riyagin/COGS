# Copy to backend/.env for local use; on Vercel set these in Project Settings -> Environment Variables.

# Database. Leave unset locally to use the embedded PGlite database.
# Supabase: Connect -> "Transaction pooler" (port 6543).
# DATABASE_URL=postgresql://postgres.gsvbbkszjsbxvekzztiu:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Auth. Leave SUPABASE_URL unset locally to skip sign-in (deployments refuse to run without it).
# SUPABASE_URL=https://gsvbbkszjsbxvekzztiu.supabase.co
# ADMIN_EMAILS=you@gmail.com
# AUTH_PROVIDERS=google
